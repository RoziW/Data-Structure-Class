public class Fibonacci {
    public static void main(String[] args) {
        int n = 10; // The loop limit (likely 10 based on the byte 0A)
        int firstTerm = 0, secondTerm = 1;
        
        // The bytecode indicates a loop calculating the series
        for (int i = 1; i <= n; ++i) {
            System.out.print(firstTerm + " "); // String concatenation detected
            
            // Logic to swap and add numbers
            int nextTerm = firstTerm + secondTerm;
            firstTerm = secondTerm;
            secondTerm = nextTerm;
        }
    }
}